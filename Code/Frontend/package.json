{
  "name": "intraspot-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/check-public-assets.mjs && next build && node scripts/check-public-assets.mjs out",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "test": "node --test ../../tests/sprint5-contract.test.mjs",
    "api:types": "openapi-typescript ../../docs/backend/openapi.json -o lib/api.generated.ts"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.0.0"
  }
}
