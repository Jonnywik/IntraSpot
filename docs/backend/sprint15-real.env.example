# PUBLIC provider settings only. Google OAuth client secrets go in Supabase's
# provider dashboard, never this repository. Do not use a service-role key.
# app.real_setup creates ignored Backend/Frontend .env.real.local files after
# validating these settings; normal .env.local stays unchanged.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_key
